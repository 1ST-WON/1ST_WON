{
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.21.0",
  "engines": {
    "node": "26.13.1"
  },
  "toolVersions": {
    "gitleaks": "8.30.1"
  },
  "scripts": {
    "prepare": "husky",
    "check-env": "node scripts/doctor.mjs",
    "infra:up": "docker compose --env-file .env -f infra/docker-compose.yml up -d",
    "infra:down": "docker compose --env-file .env -f infra/docker-compose.yml down",
    "fe:dev": "pnpm --filter frontend dev",
    "fe:lint": "pnpm --filter frontend lint",
    "fe:typecheck": "pnpm --filter frontend typecheck",
    "fe:build": "pnpm --filter frontend build",
    "be:run": "node scripts/gradle.mjs bootRun",
    "be:build": "node scripts/gradle.mjs build",
    "ct:compile": "pnpm --filter ./contracts compile"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "husky": "^9.1.7"
  }
}
